GOOGLE_API_KEY=your_google_api_key_here

# LLM configuration
LLM_PROVIDER=gemini                   # gemini | openai
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Agent mode
AGENT_MODE=graph                      # graph | react

# Workspace
WORKSPACE_ID=demo

# Persistence
CHECKPOINT_PATH=data/checkpoints.sqlite
FEEDBACK_DB_PATH=data/feedback.sqlite

# Retrieval limits
MAX_STEPS=4
HISTORY_TOKEN_LIMIT=3000
MAX_EVIDENCE_CHARS=6000

# SQL safety
SQL_MAX_ATTEMPTS=3
SQL_TIMEOUT_S=5
SQL_ALLOWED_TABLES=employees,projects,tickets  # empty = all tables
SQL_FORBIDDEN_COLUMNS=salary               # comma-separated, e.g. salary,ssn

# Retrieval mode
EMAIL_RETRIEVAL=dense                  # dense | hybrid

# Database
DATABASE_PATH=data/demo.db

# Company site URLs (comma-separated, leave empty to disable site search)
# Example: public docs from your tools/partners; replace with your own intranet URLs
COMPANY_SITE_URLS=https://www.anthropic.com/company,https://docs.anthropic.com/en/docs/intro-to-claude
